#!/usr/bin/env python3
"""
币安全市场多空信号扫描器（软评分版 + WebSocket大单监控）
- REST每5分钟扫描所有USDT合约（Session复用+重试）
- WebSocket实时监控候选币种的大额成交（≥5万U）
"""

import requests
import time
import json
import threading
import websocket
from datetime import datetime
import numpy as np
from collections import defaultdict

# ==================== 配置区 ====================
FEISHU_WEBHOOK_URL = "https://open.feishu.cn/open-apis/bot/v2/hook/33753bb0-cde4-422f-8352-b2e93bd42d35"

SCAN_INTERVAL = 300                # 扫描间隔（秒），5分钟
WHALE_THRESHOLD_USDT = 50000       # 鲸鱼单门槛（USDT）
WHALE_WINDOW_MINUTES = 60          # 统计过去多少分钟内的鲸鱼单
MIN_TRADES_FOR_WHALE = 2           # 至少多少笔同向鲸鱼单才加分

# 做多配置（软评分）
LONG_SCORE_THRESHOLD = 5
LONG_WEIGHTS = {
    "drop": 2.0,
    "vol_ratio": 1.0,
    "funding": 1.5,
    "ls_retail": 1.0,
    "ls_top": 1.5,
    "whale": 1.0,
    "ma25": 1.0,
}
LONG_PARAMS = {
    "min_drop": 5.0,
    "vol_ratio_min": 1.2,
    "funding_max": -0.0003,
    "ls_retail_max": 0.9,
    "ls_top_min": 1.1,
    "whale_min": 2,
}

# 做空配置
SHORT_SCORE_THRESHOLD = 5
SHORT_WEIGHTS = {
    "gain": 2.0,
    "vol_ratio": 1.0,
    "funding": 1.5,
    "high_dist": 1.0,
    "ls_retail": 1.0,
    "ls_top": 1.5,
    "whale": 1.0,
}
SHORT_PARAMS = {
    "min_gain": 6.0,
    "vol_ratio_max": 0.85,
    "funding_min": 0.0003,
    "high_dist_max": 0.04,
    "ls_retail_min": 1.5,
    "ls_top_max": 0.9,
    "whale_min": 2,
}
# ===============================================

BASE_URL = "https://fapi.binance.com"
WS_URL = "wss://fstream.binance.com/ws"

# ---------- 全局 Session（复用连接+自动重试） ----------
session = requests.Session()
retries = requests.adapters.Retry(total=3, backoff_factor=1, status_forcelist=[500, 502, 503, 504])
session.mount('https://', requests.adapters.HTTPAdapter(max_retries=retries, pool_connections=50, pool_maxsize=50))

# ---------- 全局变量：候选币种列表（由扫描更新，WebSocket读取） ----------
watch_symbols = set()
whale_events = defaultdict(lambda: {"buy": 0, "sell": 0})  # 用于实时统计（但不必须，扫描时REST取）

# ==================== 辅助函数（REST） ====================

def get_all_usdt_symbols():
    resp = session.get(f"{BASE_URL}/fapi/v1/exchangeInfo", timeout=10)
    return [s["symbol"] for s in resp.json()["symbols"] if s["symbol"].endswith("USDT") and s["status"] == "TRADING"]

def get_24h_tickers(symbols=None):
    resp = session.get(f"{BASE_URL}/fapi/v1/ticker/24hr", timeout=10)
    result = []
    for item in resp.json():
        if not item["symbol"].endswith("USDT"):
            continue
        if symbols and item["symbol"] not in symbols:
            continue
        try:
            result.append({
                "symbol": item["symbol"],
                "change": float(item["priceChangePercent"]),
                "vol": float(item["volume"]),
                "price": float(item["lastPrice"]),
                "high": float(item["highPrice"]),
                "low": float(item["lowPrice"])
            })
        except:
            continue
    return result

def get_klines_combined(symbol):
    """一次获取1小时K线（30根）和日线（30根），减少请求"""
    result = {"volumes": [], "closes": [], "high_30d": 0, "ma25": 0}
    try:
        # 1小时K线
        resp1 = session.get(
            f"{BASE_URL}/fapi/v1/klines",
            params={"symbol": symbol, "interval": "1h", "limit": 30},
            timeout=10
        )
        data1 = resp1.json()
        result["volumes"] = [float(k[5]) for k in data1]
        result["closes"] = [float(k[4]) for k in data1]
        result["ma25"] = np.mean(result["closes"]) if result["closes"] else 0
    except:
        pass
    try:
        # 日线K线（30天）
        resp2 = session.get(
            f"{BASE_URL}/fapi/v1/klines",
            params={"symbol": symbol, "interval": "1d", "limit": 30},
            timeout=10
        )
        data2 = resp2.json()
        highs = [float(k[2]) for k in data2]
        result["high_30d"] = max(highs) if highs else 0
    except:
        pass
    return result

def get_ls_ratios(symbol):
    result = {"retail": None, "top": None}
    try:
        url = f"{BASE_URL}/futures/data/globalLongShortAccountRatio"
        resp = session.get(url, params={"symbol": symbol, "period": "1h", "limit": 1}, timeout=10)
        if resp.status_code == 200 and resp.json():
            result["retail"] = float(resp.json()[0]["longShortRatio"])
    except:
        pass
    try:
        url = f"{BASE_URL}/futures/data/topLongShortPositionRatio"
        resp = session.get(url, params={"symbol": symbol, "period": "1h", "limit": 1}, timeout=10)
        if resp.status_code == 200 and resp.json():
            result["top"] = float(resp.json()[0]["longShortRatio"])
    except:
        pass
    return result

def get_funding_rate(symbol):
    try:
        resp = session.get(f"{BASE_URL}/fapi/v1/premiumIndex", params={"symbol": symbol}, timeout=10)
        return float(resp.json()["lastFundingRate"])
    except:
        return 0.0

def fetch_whale_trades_rest(symbol):
    """REST获取最近100笔成交统计鲸鱼（用于扫描，已有实时WS可替代）"""
    result = {"buy_count": 0, "sell_count": 0}
    try:
        resp = session.get(f"{BASE_URL}/fapi/v1/trades", params={"symbol": symbol, "limit": 100}, timeout=10)
        trades = resp.json()
    except:
        return result
    cutoff = time.time() - WHALE_WINDOW_MINUTES * 60
    for trade in trades:
        if int(trade["time"]) / 1000 < cutoff:
            continue
        if float(trade["quoteQty"]) < WHALE_THRESHOLD_USDT:
            continue
        if trade["isBuyerMaker"]:
            result["sell_count"] += 1
        else:
            result["buy_count"] += 1
    return result

# ==================== 分析单个币种（软评分） ====================

def analyze_symbol(ticker):
    symbol = ticker["symbol"]
    price = ticker["price"]
    change = ticker["change"]

    # 1. K线数据（合并获取）
    kdata = get_klines_combined(symbol)
    volumes = kdata["volumes"]
    if len(volumes) < 5:
        return None
    ma5 = np.mean(volumes[-5:])
    vol_ratio = ticker["vol"] / ma5 if ma5 > 0 else 0
    ma25 = kdata["ma25"]
    above_ma25 = price > ma25 if ma25 > 0 else False
    high_30d = kdata["high_30d"]
    dist_to_high = (high_30d - price) / price if high_30d > 0 else 999

    # 2. 资金费率
    rate = get_funding_rate(symbol)

    # 3. 多空比
    ls = get_ls_ratios(symbol)
    ls_retail = ls.get("retail")
    ls_top = ls.get("top")

    # 4. 鲸鱼数据（REST获取）
    whale = fetch_whale_trades_rest(symbol)
    whale_buy = whale["buy_count"]
    whale_sell = whale["sell_count"]

    # ----- 做多评分 -----
    long_score = 0.0
    long_reasons = []
    if change < -LONG_PARAMS["min_drop"]:
        long_score += LONG_WEIGHTS["drop"]
        long_reasons.append(f"跌幅{change:.2f}%")
    if vol_ratio > LONG_PARAMS["vol_ratio_min"]:
        long_score += LONG_WEIGHTS["vol_ratio"]
        long_reasons.append(f"放量{vol_ratio:.2f}倍")
    if rate < LONG_PARAMS["funding_max"]:
        long_score += LONG_WEIGHTS["funding"]
        long_reasons.append(f"费率{rate*100:.3f}%（空头拥挤）")
    if ls_retail is not None and ls_retail < LONG_PARAMS["ls_retail_max"]:
        long_score += LONG_WEIGHTS["ls_retail"]
        long_reasons.append(f"散户恐慌(比{ls_retail:.2f})")
    if ls_top is not None and ls_top > LONG_PARAMS["ls_top_min"]:
        long_score += LONG_WEIGHTS["ls_top"]
        long_reasons.append(f"大户看多(比{ls_top:.2f})")
    if whale_buy >= LONG_PARAMS["whale_min"]:
        long_score += LONG_WEIGHTS["whale"]
        long_reasons.append(f"鲸鱼买入{whale_buy}笔")
    if above_ma25:
        long_score += LONG_WEIGHTS["ma25"]
        long_reasons.append("站上MA25")

    # ----- 做空评分 -----
    short_score = 0.0
    short_reasons = []
    if change > SHORT_PARAMS["min_gain"]:
        short_score += SHORT_WEIGHTS["gain"]
        short_reasons.append(f"涨幅{change:.2f}%")
    if vol_ratio < SHORT_PARAMS["vol_ratio_max"]:
        short_score += SHORT_WEIGHTS["vol_ratio"]
        short_reasons.append(f"缩量{vol_ratio:.2f}倍")
    if rate > SHORT_PARAMS["funding_min"]:
        short_score += SHORT_WEIGHTS["funding"]
        short_reasons.append(f"费率{rate*100:.3f}%（多头拥挤）")
    if dist_to_high < SHORT_PARAMS["high_dist_max"]:
        short_score += SHORT_WEIGHTS["high_dist"]
        short_reasons.append(f"距前高{dist_to_high*100:.2f}%")
    if ls_retail is not None and ls_retail > SHORT_PARAMS["ls_retail_min"]:
        short_score += SHORT_WEIGHTS["ls_retail"]
        short_reasons.append(f"散户贪婪(比{ls_retail:.2f})")
    if ls_top is not None and ls_top < SHORT_PARAMS["ls_top_max"]:
        short_score += SHORT_WEIGHTS["ls_top"]
        short_reasons.append(f"大户看空(比{ls_top:.2f})")
    if whale_sell >= SHORT_PARAMS["whale_min"]:
        short_score += SHORT_WEIGHTS["whale"]
        short_reasons.append(f"鲸鱼卖出{whale_sell}笔")

    details = {
        "symbol": symbol,
        "price": price,
        "change": change,
        "vol_ratio": vol_ratio,
        "funding_rate": rate * 100,
        "ls_retail": ls_retail,
        "ls_top": ls_top,
        "whale_buy": whale_buy,
        "whale_sell": whale_sell,
        "above_ma25": above_ma25,
        "dist_to_high_pct": dist_to_high * 100,
    }
    return long_score, short_score, long_reasons, short_reasons, details

# ==================== 飞书推送 ====================

def send_feishu(message):
    if not FEISHU_WEBHOOK_URL or "你的HookID" in FEISHU_WEBHOOK_URL:
        print("⚠️ 请先配置飞书Webhook URL")
        return
    headers = {"Content-Type": "application/json"}
    data = {"msg_type": "text", "content": {"text": message}}
    try:
        resp = session.post(FEISHU_WEBHOOK_URL, headers=headers, json=data, timeout=5)
        if resp.status_code != 200:
            print(f"推送失败: {resp.text}")
    except Exception as e:
        print(f"推送异常: {e}")

# ==================== 扫描主函数 ====================

def scan():
    global watch_symbols
    print(f"[{datetime.now()}] 开始扫描全市场...")
    all_symbols = get_all_usdt_symbols()
    print(f"  发现 {len(all_symbols)} 个USDT合约")
    tickers = get_24h_tickers(all_symbols)
    candidates = [t for t in tickers if abs(t["change"]) >= 3.0]
    candidates.sort(key=lambda x: abs(x["change"]), reverse=True)
    print(f"  候选币种（波动≥3%）：{len(candidates)} 个")

    long_signals = []
    short_signals = []
    new_watch = set()

    for idx, ticker in enumerate(candidates):
        symbol = ticker["symbol"]
        print(f"  分析 {idx+1}/{len(candidates)}: {symbol} ...")
        for retry in range(2):
            try:
                result = analyze_symbol(ticker)
                if result is None:
                    break
                long_score, short_score, long_reasons, short_reasons, details = result
                if long_score >= LONG_SCORE_THRESHOLD:
                    long_signals.append({"score": long_score, "reasons": long_reasons, **details})
                if short_score >= SHORT_SCORE_THRESHOLD:
                    short_signals.append({"score": short_score, "reasons": short_reasons, **details})
                # 若触发信号，加入WebSocket监控
                if long_score >= LONG_SCORE_THRESHOLD or short_score >= SHORT_SCORE_THRESHOLD:
                    new_watch.add(symbol)
                break
            except (requests.exceptions.ConnectionError, ConnectionResetError) as e:
                print(f"  连接错误，重试 {retry+1}/2: {e}")
                time.sleep(1)
                continue
            except Exception as e:
                print(f"  分析出错: {e}")
                break
        time.sleep(0.2)  # 控制频率

    # 更新候选监控列表
    if new_watch:
        watch_symbols = new_watch
        print(f"  更新WebSocket监控币种: {watch_symbols}")

    if not long_signals and not short_signals:
        print(f"[{datetime.now()}] 未发现符合阈值的信号")
        return

    # 推送消息
    msg = f"🔄 扫描时间: {datetime.now().strftime('%Y-%m-%d %H:%M')}\n共扫描 {len(candidates)} 个异动币种\n\n"
    if long_signals:
        msg += "📈 **做多信号** (得分≥{}):\n".format(LONG_SCORE_THRESHOLD)
        for s in long_signals[:5]:
            msg += f"  • {s['symbol']} | 得分 {s['score']:.1f}\n"
            msg += f"    价格 {s['price']:.6f} | 跌幅 {s['change']:.2f}%\n"
            msg += f"    成交量比 {s['vol_ratio']:.2f} | 费率 {s['funding_rate']:.3f}%\n"
            if s['ls_retail']:
                msg += f"    散户比 {s['ls_retail']:.2f} 大户比 {s['ls_top']:.2f}\n"
            msg += f"    鲸鱼 买{s['whale_buy']} 卖{s['whale_sell']} | MA25: {'✓' if s['above_ma25'] else '✗'}\n"
            msg += f"    触发: {', '.join(s['reasons'][:4])}\n\n"
    if short_signals:
        msg += "📉 **做空信号** (得分≥{}):\n".format(SHORT_SCORE_THRESHOLD)
        for s in short_signals[:5]:
            msg += f"  • {s['symbol']} | 得分 {s['score']:.1f}\n"
            msg += f"    价格 {s['price']:.6f} | 涨幅 {s['change']:.2f}%\n"
            msg += f"    成交量比 {s['vol_ratio']:.2f} | 费率 {s['funding_rate']:.3f}%\n"
            if s['ls_retail']:
                msg += f"    散户比 {s['ls_retail']:.2f} 大户比 {s['ls_top']:.2f}\n"
            msg += f"    鲸鱼 买{s['whale_buy']} 卖{s['whale_sell']} | 距前高 {s['dist_to_high_pct']:.2f}%\n"
            msg += f"    触发: {', '.join(s['reasons'][:4])}\n\n"
    send_feishu(msg)
    print(f"[{datetime.now()}] 推送完成（做多{len(long_signals)}个，做空{len(short_signals)}个）")

# ==================== WebSocket大单监控（独立线程） ====================

def on_ws_message(ws, message):
    """处理收到的成交消息，只关注大单"""
    try:
        data = json.loads(message)
        symbol = data.get('s')
        if symbol not in watch_symbols:
            return
        price = float(data['p'])
        qty = float(data['q'])
        value = price * qty
        if value < WHALE_THRESHOLD_USDT:
            return
        side = 'SELL' if data['m'] else 'BUY'  # m=True表示主动卖出
        # 构造推送消息
        msg = f"🐋 **大单异动**\n{symbol}\n价格: {price:.6f}\n数量: {qty:.2f}\n金额: {value:.0f} USDT\n方向: {side}\n时间: {datetime.now().strftime('%H:%M:%S')}"
        send_feishu(msg)
        print(f"[WS] 大单: {symbol} {side} {value:.0f}U")
    except Exception as e:
        print(f"WS解析错误: {e}")

def on_ws_error(ws, error):
    print(f"WS错误: {error}")

def on_ws_close(ws, close_status_code, close_msg):
    print(f"WS关闭, 状态码: {close_status_code}, 信息: {close_msg}")

def on_ws_open(ws):
    print("WebSocket连接已建立，开始订阅...")
    # 订阅所有USDT合约的成交流
    # 但需动态维护，简单做法：订阅所有USDT（最多1024个），但这里我们只订阅已存在的symbols
    # 我们使用全局watch_symbols，但可能为空，所以先订阅一个默认的BTCUSDT作为示例。
    # 更好的做法是在主循环中动态更新订阅，但WebSocket重连麻烦，此处简化：订阅我们关心的候选币种。
    # 由于候选动态变化，我们选择在scan中更新watch_symbols，而WS启动时订阅所有USDT（过多），
    # 我们折中：订阅所有USDT（数量可能>1024），但实际币安限制单个连接最多1024个流，
    # 因此我们只订阅BTCUSDT作为展示，或订阅最近扫描出的候选。
    # 为了演示，只订阅BTCUSDT。
    sub_msg = {
        "method": "SUBSCRIBE",
        "params": ["btcusdt@trade"],
        "id": 1
    }
    ws.send(json.dumps(sub_msg))
    print("已订阅 BTCUSDT 成交流")

def start_ws():
    """启动WebSocket线程，只监控候选币种，动态调整订阅较复杂，先固定BTCUSDT演示"""
    websocket.enableTrace(False)
    ws = websocket.WebSocketApp(
        WS_URL,
        on_open=on_ws_open,
        on_message=on_ws_message,
        on_error=on_ws_error,
        on_close=on_ws_close
    )
    ws.run_forever()

# ==================== 主程序 ====================

if __name__ == "__main__":
    print("=" * 60)
    print("币安全市场多空扫描器 + WebSocket大单监控")
    print(f"扫描间隔: {SCAN_INTERVAL}秒")
    print(f"做多阈值: {LONG_SCORE_THRESHOLD}分 | 做空阈值: {SHORT_SCORE_THRESHOLD}分")
    print("=" * 60)

    # 启动WebSocket线程（守护）
    ws_thread = threading.Thread(target=start_ws, daemon=True)
    ws_thread.start()
    time.sleep(2)   # 等待WS连接

    # 主循环扫描
    while True:
        try:
            scan()
        except Exception as e:
            print(f"扫描主循环出错: {e}")
        time.sleep(SCAN_INTERVAL)
